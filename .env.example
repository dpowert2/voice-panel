# Copy this to `.env` and fill in. The aiohttp backend (app.py) loads it via
# python-dotenv on startup. Never commit `.env`.

# Anthropic — Claude Sonnet for personas, Claude Haiku for the director.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ElevenLabs — TTS for each persona voice. Free tier is rate-limited; upgrade
# to Starter ($5/mo) if your account gets flagged for "unusual activity."
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVEN_API_KEY=
