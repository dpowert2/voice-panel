# Copy to .env and fill in. (orchestrator.py loads this via python-dotenv.)

# --- LiveKit (free Build tier is fine; create a project at cloud.livekit.io) ---
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Models / speech ---
ANTHROPIC_API_KEY=

# STT now runs via LiveKit Inference (uses your LIVEKIT_* creds above) — no
# Deepgram signup/key needed. Leave DEEPGRAM_API_KEY unset unless you switch
# orchestrator.py back to the direct deepgram.STT() plugin.
# DEEPGRAM_API_KEY=

# TTS: keep Cartesia for the distinct per-persona voices. (You can also route
# Cartesia TTS through LiveKit Inference if its signup also gives trouble.)
CARTESIA_API_KEY=

# Optional: if you switch TTS to ElevenLabs instead of Cartesia
# ELEVEN_API_KEY=
